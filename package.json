{
  "name": "nativesmart",
  "version": "0.1.0",
  "private": true,
  "description": "Mobile production infrastructure for React Native and Flutter products.",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "check": "pnpm build && pnpm typecheck && pnpm lint && pnpm test && pnpm catalog:validate && pnpm architecture:validate",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "flutter:check": "node tooling/scripts/check-flutter.mjs",
    "flutter:check:optional": "node tooling/scripts/check-flutter.mjs --allow-missing",
    "clean": "turbo run clean && pnpm -r exec rimraf node_modules",
    "catalog:validate": "node tooling/scripts/validate-product-catalog.mjs",
    "architecture:validate": "pnpm --filter @nativesmart/platform-registry validate",
    "tokens:build": "pnpm --filter @nativesmart/tokens build",
    "release": "changeset publish",
    "version": "changeset version"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.9",
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
