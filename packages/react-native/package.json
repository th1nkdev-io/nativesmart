{
  "name": "@nativesmart/react-native",
  "version": "0.1.0",
  "private": false,
  "description": "Expo-friendly React Native UI and business components for Nativesmart.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "react-native": "src/index.ts",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@nativesmart/core": "workspace:*",
    "@nativesmart/tokens": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18.2.0",
    "react-native": ">=0.74.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
