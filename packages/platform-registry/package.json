{
  "name": "@nativesmart/platform-registry",
  "version": "0.1.0",
  "private": false,
  "description": "Renderer target inventory and conformance status for Nativesmart.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "validate": "node dist/validate.js",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@nativesmart/contracts": "workspace:*",
    "@nativesmart/design-systems": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
